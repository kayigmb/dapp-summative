# Env for `docker compose up`, covers every service in docker-compose.yml.
# Usage: cp .env.docker.example .env.docker, fill in the secrets below, then:
#   docker compose --env-file .env.docker up --build

# postgres
POSTGRES_USER=chaintrack
POSTGRES_PASSWORD=
POSTGRES_DB=chaintrack
POSTGRES_PORT=5488

# backend
JWT_SECRET=
ADMIN_EMAIL=admin@chaintrack.test
ADMIN_PASSWORD=
FRONTEND_ORIGIN=http://localhost:3000

# blockchain (leave blank until you've deployed the contract to the hardhat service)
CONTRACT_ADDRESS=
PRIVATE_KEY=

# frontend (baked in at image build time)
VITE_API_URL=http://localhost:5001
VITE_NETWORK=localhost
VITE_SITE_URL=http://localhost:3000
